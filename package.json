{
  "name": "rocksoul-correlation",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Public provenance-first correlation graph with qualified references, challenge-aware traversal, provenance, freshness and targeted re-analysis.",
  "exports": {
    ".": "./src/runtime.mjs",
    "./server": "./src/server.mjs",
    "./freshness": "./src/freshness.mjs",
    "./qualified-ref": "./src/qualified-ref.mjs",
    "./reanalysis": "./src/reanalysis.mjs"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node src/server.mjs",
    "ci": "npm run validate && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
